# Приложение
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-Id

# Повторы
MAX_RETRIES=2
RETRY_BACKOFF_MS=50

# HTTP-пул
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE_CONNECTIONS=50

# Лимитер: сколько ждать слот перед сбросом запроса
LIMITER_TIMEOUT_MS=200

# PostgreSQL / Redis
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0

# Аудит в PostgreSQL.
# Для нагрузочного теста лучше держать false, чтобы не влиять на p95.
AUDIT_ENABLED=false

# Circuit breaker в Redis
CIRCUIT_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=100
CIRCUIT_COOLDOWN_MS=1000

# Адреса сервисов для локального запуска
USERS_BASE_URL=http://127.0.0.1:8001
ORDERS_BASE_URL=http://127.0.0.1:8002
PAYMENTS_BASE_URL=http://127.0.0.1:8003

# users
USERS_CONNECT_TIMEOUT_MS=200
USERS_READ_TIMEOUT_MS=1000
USERS_TOTAL_TIMEOUT_MS=2000
USERS_MAX_CONCURRENCY=100

# orders
ORDERS_CONNECT_TIMEOUT_MS=200
ORDERS_READ_TIMEOUT_MS=800
ORDERS_TOTAL_TIMEOUT_MS=1000
ORDERS_MAX_CONCURRENCY=100

# payments
PAYMENTS_CONNECT_TIMEOUT_MS=200
PAYMENTS_READ_TIMEOUT_MS=1000
PAYMENTS_TOTAL_TIMEOUT_MS=2000
PAYMENTS_MAX_CONCURRENCY=100